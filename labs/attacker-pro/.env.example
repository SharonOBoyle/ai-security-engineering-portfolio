# RedCell — copy to .env:   cp .env.example .env
# RedCell runs WITHOUT any keys (deterministic code fallbacks + the in-process mock target). Add models to
# make each stage smarter, and point it at your real MerciBank to attack a live agent.

# ---- TARGET (default: your own Week-2 MerciBank; localhost only unless ROE_AUTHORIZED) ----
RC_ADAPTER=mercibank                       # mercibank | mock | openai | http
MERCI_TARGET_URL=http://localhost:8080/v1/chat/completions
MERCI_TARGET_KEY=merci-lab-key             # must match ../week2-mercibank/.env

# A generic OpenAI-compatible target (RC_ADAPTER=openai):
# RC_TARGET_URL=http://127.0.0.1:11434/v1
# RC_TARGET_KEY=local
# RC_TARGET_MODEL=llama3.1
# A generic HTTP-JSON target (RC_ADAPTER=http): point at a spec file (see adapters/http.mjs):
# RC_TARGET_SPEC=./target-spec.json

# ---- THE BRAINS (all optional). Every stage falls back to ATTACKER_LLM_* ; set that one to light up all. ----
# PROVIDER picks the wire format. "openai" (default) covers OpenRouter / OpenAI / Groq / Together / local
# (vMLX, Ollama, LM Studio) — anything speaking /chat/completions. "anthropic" uses the native Messages API.
# Leave BASE_URL blank to use the provider's default base URL.
#
#   --- OpenRouter (verified for the cohort) ---
# ATTACKER_LLM_PROVIDER=openrouter
# ATTACKER_LLM_API_KEY=sk-or-...
# ATTACKER_LLM_MODEL=openai/gpt-4o-mini
#
#   --- OpenAI directly ---
# ATTACKER_LLM_PROVIDER=openai
# ATTACKER_LLM_API_KEY=sk-...
# ATTACKER_LLM_MODEL=gpt-4o-mini
#
#   --- Anthropic (native) ---
# ATTACKER_LLM_PROVIDER=anthropic
# ATTACKER_LLM_API_KEY=sk-ant-...
# ATTACKER_LLM_MODEL=claude-haiku-4-5-20251001
#
#   --- Local, free, no bans (Mac): vMLX / Ollama / LM Studio ---
# ATTACKER_LLM_PROVIDER=openai
# ATTACKER_LLM_BASE_URL=http://127.0.0.1:11434/v1
# ATTACKER_LLM_API_KEY=local
# ATTACKER_LLM_MODEL=llama3.1
#
# Optional per-stage overrides (otherwise they use ATTACKER_LLM_*):
# RECON_LLM_MODEL=...        # ORIENT: fingerprint the target
# STRATEGIST_LLM_MODEL=...   # PLAN: technique composition + the "lesson" after a miss
# JUDGE_LLM_MODEL=...        # JUDGE rubric second opinion + VERIFY baseline
# REPORT_LLM_MODEL=...       # REPORT: dev + stakeholder prose
#
# Why a separate / local / red-team-tuned model: an aligned cloud model often refuses to help author attacks,
# and attack traffic can get a commercial key flagged. A local open model avoids both — and everything still
# stays inside the localhost lab and the ROE. Never point a brain or the target at anything but the lab.

# ---- CAMPAIGN KNOBS (all optional) ----
# EPISODES=12          # attack laps
# MAX_TURNS=4          # messages per strategy before giving up / escalating
# ATTACK_DELAY_MS=400  # pause between calls (keep under MerciBank's ~40 req/min rate limit)
# UCB_C=1.41           # explore/exploit knob for the bandit planner
# REPRO_RUNS=3         # verify: parallel reproductions
# REPRO_MIN=3          # verify: how many must leak to CONFIRM (the "3 of 3" rule)
# BEST_OF_N=3 TREE_WIDTH=3 TREE_DEPTH=2   # orchestrator knobs
# RC_SEED=demo         # make the mock target deterministic (repeatable demo)
# RC_DASHBOARD_PORT=8787

# ---- AUTHORIZED ENGAGEMENT (beyond the lab) — leave OFF for the cohort ----
# ROE_AUTHORIZED=1
# RC_TARGET_ALLOWLIST=staging.client.example,api.client.example
